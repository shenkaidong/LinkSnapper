# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- 浏览器 ----
# Chrome / Chromium 可执行文件路径
# 通常不需要设置，程序会自动探测系统已安装的浏览器：
#   macOS   -> /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux   -> /usr/bin/google-chrome 或 chromium
#   Windows -> %PROGRAMFILES%\Google\Chrome\Application\chrome.exe
# Docker 镜像内已自动设为 /usr/bin/chromium-browser
# CHROME_PATH=/usr/bin/google-chrome

# 浏览器实例空闲多久后回收（毫秒），默认 60000
# 复用同一个 Chromium 实例可以省掉每次请求 0.5～1.5 秒的冷启动，
# 空闲回收则避免长期占着内存。
# BROWSER_IDLE_SHUTDOWN_MS=60000

# 页面导航超时（毫秒），默认 30000
# NAV_TIMEOUT_MS=30000

# 覆盖默认 User-Agent
# SCREENSHOT_USER_AGENT=Mozilla/5.0 ...

# ---- 安全 ----
# 是否允许截图内网 / 本机地址（默认 false）
# 关闭是防 SSRF 的关键：截图接口本质是「让服务器访问任意地址」，
# 不限制的话可以被用来探测内网服务与云厂商元数据接口。
# 只有确实需要截图内网系统时才改为 true。**生产环境强烈建议保持 false。**
ALLOW_PRIVATE_NETWORK=false

# 精确放行的内网主机（逗号分隔），默认空
# 相比 ALLOW_PRIVATE_NETWORK=true 的一刀切，这里可以只放行确实需要的那几个主机。
# 例：只允许截图内网 wiki，其余内网地址仍然被拦。
# ALLOWED_INTERNAL_HOSTS=wiki.internal,10.0.0.20

# 访问令牌。设置后所有截图 / 拼接请求都必须带：
#   Authorization: Bearer <token>  或  x-api-token: <token>
# 公网部署时务必设置，否则任何人都能直接调用。
# SCREENSHOT_API_TOKEN=

# ---- 限流（按客户端 IP 的令牌桶）----
# 桶容量，即允许的突发次数，默认 6
# RATE_LIMIT_CAPACITY=6
# 每秒补充多少令牌，默认 0.2（约 12 次/分钟）
# RATE_LIMIT_REFILL_PER_SEC=0.2

# ---- 并发 ----
# 同时最多几个截图任务，默认 3（每个都会拉起一个 Chromium）
# MAX_CONCURRENT_CAPTURES=3
# 等待队列长度上限，超出直接返回 503，默认 24
# MAX_QUEUE_LENGTH=24
# 排队超时（毫秒），默认 45000
# QUEUE_TIMEOUT_MS=45000

# ---- 尺寸上限 ----
# 整页截图高度上限，超过则提示改用分段截图，默认 30000
# MAX_FULLPAGE_HEIGHT=30000

# ---- 视觉变更监控（截图 diff）----
# 基准图存放目录，默认 ./.snapshots
# 建议挂一个持久卷（Docker 见 docker-compose.yml），否则每次重启服务基准就丢了。
# SNAPSHOT_DIR=/var/lib/linksnapper/snapshots

# 最多保留多少份基准图，超出后淘汰最旧的，默认 200。
# 不设上限的话，跑几个月的巡检就能把磁盘写满 —— 那时候连截图都存不下来。
# MAX_SNAPSHOTS=200

# 比对时两张图缩放到多大（像素），默认 1600。
# 整页截图 1920×30000 逐像素扫描是几千万次迭代，会卡住事件循环；
# 缩小后统计结果按缩放比换算回原图坐标，结论不变但快得多。
# 想看像素级细节就调大它，代价是内存与时间。
# SNAPSHOT_DIFF_MAX_SIDE=1600

# 判定"变了"的色差阈值（单通道 0-255），默认 16。
# 调低能抓细微样式改动，调高能忽略抗锯齿抖动；设为 0 等于把噪声全算成变化。
# SNAPSHOT_DIFF_THRESHOLD=16
